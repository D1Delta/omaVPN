[Unit]
Description=omavpn system daemon (sing-box + TUN)
After=network-online.target systemd-resolved.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/omavpnd --socket /run/omavpn/omavpnd.sock --runtime-dir /run/omavpn --socket-mode 660
RuntimeDirectory=omavpn
RuntimeDirectoryMode=0750
Group=wheel
UMask=0027

# Minimal Linux capabilities required for TUN creation, routing rules, and binding
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW

Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
